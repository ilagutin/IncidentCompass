# Copy to an ignored .env.production file. Values such as change-me and the
# shipped Development defaults are intentionally rejected by the preflight.

INCIDENTCOMPASS_COMPOSE_PROJECT=incidentcompass-production
INCIDENTCOMPASS_IMAGE_TAG=local
IC_API_PORT=5198
IC_POSTGRES_PORT=5432

POSTGRES_DB=incidentcompass_production
POSTGRES_USER=incidentcompass_operator
POSTGRES_PASSWORD=change-me-to-a-long-random-database-password

# The client sends the raw API key. Only its lowercase or uppercase SHA-256
# hex digest belongs in this file.
INCIDENTCOMPASS_API_KEY_ID=primary-operator
INCIDENTCOMPASS_TENANT_ID=production
INCIDENTCOMPASS_API_KEY_SHA256=change-me-to-the-64-character-sha256-digest
INCIDENTCOMPASS_API_KEY_AUTH_ENABLED=true
INCIDENTCOMPASS_API_KEY_PERMIT_LIMIT=60
INCIDENTCOMPASS_API_KEY_WINDOW_SECONDS=60

# Use exact non-demo model identifiers and credentials. HTTPS is expected for
# remote providers. Set the loopback override only for localhost or
# host.docker.internal on the trusted machine.
INCIDENTCOMPASS_LLM_BASE_URL=https://provider.example.invalid
INCIDENTCOMPASS_LLM_CHAT_COMPLETIONS_PATH=/v1/chat/completions
INCIDENTCOMPASS_LLM_MODEL=change-me-to-a-real-chat-model
INCIDENTCOMPASS_LLM_API_KEY=change-me-to-a-real-model-key
INCIDENTCOMPASS_EMBEDDINGS_BASE_URL=https://provider.example.invalid
INCIDENTCOMPASS_EMBEDDINGS_PATH=/v1/embeddings
INCIDENTCOMPASS_EMBEDDINGS_MODEL=change-me-to-a-real-embedding-model
INCIDENTCOMPASS_EMBEDDINGS_API_KEY=change-me-to-a-real-embedding-key
INCIDENTCOMPASS_ALLOW_INSECURE_LOOPBACK_PROVIDER=false

# This must be an existing absolute host path. Compose mounts it read-only.
INCIDENTCOMPASS_SOURCE_ROOT=C:/absolute/path/to/monitored/repository
INCIDENTCOMPASS_SOURCE_SERVICE=change-me-to-the-configured-service
INCIDENTCOMPASS_SOURCE_RELEASE=change-me-to-the-configured-release

# The current read/write GitHub adapter binding is host-owned. Later branch
# and pull-request credentials are not part of this release item.
INCIDENTCOMPASS_GITHUB_OWNER=change-me-to-the-owner
INCIDENTCOMPASS_GITHUB_REPOSITORY=change-me-to-the-repository
INCIDENTCOMPASS_GITHUB_TOKEN=change-me-to-a-current-token

INCIDENTCOMPASS_MEMORY_SEED_ENABLED=true
INCIDENTCOMPASS_MEMORY_SEED_OWNER=production

# Leave all four Telegram values empty/false unless the configured route is
# enabled. When true, preflight requires the complete binding.
INCIDENTCOMPASS_TELEGRAM_ENABLED=false
INCIDENTCOMPASS_TELEGRAM_ROUTE_ID=
INCIDENTCOMPASS_TELEGRAM_CHAT_ID=
INCIDENTCOMPASS_TELEGRAM_BOT_TOKEN=

INCIDENTCOMPASS_LOG_MAX_SIZE=10m
INCIDENTCOMPASS_LOG_MAX_FILES=5
