<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>

    <!-- CA1707 fires on the xUnit `MethodUnderTest_Scenario_ExpectedResult` test-method naming
         convention used throughout this project; renaming every test method to remove underscores
         would fight a near-universal .NET testing idiom for no behavioral benefit.
         CA1711 fires on TriageConfigurationConsoleCollection, an xUnit [CollectionDefinition]
         marker class - "XyzCollection" is the standard xUnit naming convention for these. -->
    <NoWarn>$(NoWarn);CA1707;CA1711</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared with IncidentCompass.IntegrationTests via file link: the two test projects do not
         reference each other, so a physical file under tests\Shared is the only way to give both
         a single RepositoryRootLocator implementation instead of per-file copies. -->
    <Compile Include="..\Shared\RepositoryRootLocator.cs" Link="Support\RepositoryRootLocator.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\IncidentCompass.Application\IncidentCompass.Application.csproj" />
    <ProjectReference Include="..\..\src\IncidentCompass.Domain\IncidentCompass.Domain.csproj" />
    <ProjectReference Include="..\..\src\IncidentCompass.Infrastructure\IncidentCompass.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\IncidentCompass.Tester\IncidentCompass.Tester.csproj" />
    <ProjectReference Include="..\..\src\IncidentCompass.Worker\IncidentCompass.Worker.csproj" />
  </ItemGroup>

</Project>
