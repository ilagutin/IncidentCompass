<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Integration tests suppress xUnit1051 because host/client APIs expose many optional tokens;
         cancellation-sensitive paths pass TestContext.Current.CancellationToken explicitly.
         CA1707 fires on the xUnit `MethodUnderTest_Scenario_ExpectedResult` test-method naming
         convention used throughout this project; renaming every test method to remove underscores
         would fight a near-universal .NET testing idiom for no behavioral benefit.
         CA1711 fires on ApiKeyAuthenticationCollection and PostgresRepositoryCollection, xUnit
         [CollectionDefinition] marker classes - "XyzCollection" is the standard xUnit naming
         convention for these. -->
    <NoWarn>$(NoWarn);xUnit1051;CA1707;CA1711</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared with IncidentCompass.UnitTests via file link: the two test projects do not
         reference each other, so a physical file under tests\Shared is the only way to give both
         a single RepositoryRootLocator and TriageConfigurationFileLocator implementation instead
         of per-file copies. -->
    <Compile Include="..\Shared\RepositoryRootLocator.cs" Link="Support\RepositoryRootLocator.cs" />
    <Compile Include="..\Shared\TriageConfigurationFileLocator.cs" Link="Support\TriageConfigurationFileLocator.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Baselines\openapi-v1.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Fixtures\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\samples\incidents\tester-ticket-action-injection.json"
          Link="Samples\Incidents\tester-ticket-action-injection.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\IncidentCompass.Application\IncidentCompass.Application.csproj" />
    <ProjectReference Include="..\..\src\IncidentCompass.Api\IncidentCompass.Api.csproj" />
    <ProjectReference Include="..\..\src\IncidentCompass.Infrastructure\IncidentCompass.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\IncidentCompass.Worker\IncidentCompass.Worker.csproj" />
  </ItemGroup>

</Project>
