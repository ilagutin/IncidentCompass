<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Domain arrives transitively through Application, the same way it reaches Api and Worker.
         Redeclaring it here would be the only place in the solution that names it twice. -->
    <ProjectReference Include="..\IncidentCompass.Application\IncidentCompass.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Pgvector" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\infra\postgres\init\*.sql" Link="PostgresSchemaScripts\%(Filename)%(Extension)" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- CA1822 fires on instantiable collaborators whose methods do not touch instance state:
         the Embeddings/OpenAi request factory, response mapper, error mapper and options
         resolver; the shared OpenAiCompatible retry policy; PostgresDocumentationFitResolver;
         and PostgresMigrationLedger. Those types stay instantiable because they are composed
         through constructor injection (see docs/model-gateway.md) rather than being static
         utility classes. ModelGateway/OpenAi request factories, response mappers and error
         mappers are static and do not need this suppression. -->
    <NoWarn>$(NoWarn);CA1822</NoWarn>
  </PropertyGroup>

</Project>
