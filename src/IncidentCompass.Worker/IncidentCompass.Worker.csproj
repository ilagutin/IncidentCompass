<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-IncidentCompass.Worker-6f348300-9fb5-4269-8ca2-0591b47c6738</UserSecretsId>

    <!-- CA1822 fires on WorkerJobLeaseRenewer.RenewUntilStoppedAsync and
         PostReportActionEvaluationLeaseRenewer.RenewUntilStoppedAsync. Both types are DI-registered
         singleton pump collaborators (see Setup.cs); PostReportActionEvaluationLeaseRenewer's
         sibling EvaluateAsync method does use instance state (the injected logger), so the type
         is not purely static, and keeping both lease-renewal methods on the same instantiable
         shape keeps the pair symmetric. -->
    <NoWarn>$(NoWarn);CA1822</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IncidentCompass.Application\IncidentCompass.Application.csproj" />
    <ProjectReference Include="..\IncidentCompass.Infrastructure\IncidentCompass.Infrastructure.csproj" />
  </ItemGroup>
</Project>
