<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\samples\incidents\tester-ticket-action-injection.json"
          Link="Samples\Incidents\tester-ticket-action-injection.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\evaluations\triage\corpus-v1.json"
          Link="Evaluations\Triage\corpus-v1.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
