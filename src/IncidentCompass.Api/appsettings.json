{
  "IncidentCompass": {
    "Application": {
      "ApiVersion": "v1"
    },
    "ModelGateway": {
      "Provider": "OpenAICompatible",
      "DefaultModel": "local-model",
      "StrongModel": "local-model",
      "CheapModel": "local-model",
      "EvaluationModel": "local-model",
      "DefaultTemperature": 0.2,
      "DefaultMaxOutputTokens": 512,
      "MaxInputMessageCharacters": 8000,
      "AllowedModels": [],
      "MinTemperature": 0,
      "MaxTemperature": 1,
      "MaxOutputTokensLimit": 2048,
      "MaxCorrelationIdLength": 128,
      "OpenAiCompatible": {
        "BaseUrl": "http://localhost:1234",
        "ChatCompletionsPath": "/v1/chat/completions",
        "ApiKey": "local-dev-key",
        "TimeoutSeconds": 300,
        "MaxRetryAttempts": 2,
        "RetryBaseDelayMilliseconds": 200,
        "MaxRetryDelaySeconds": 5,
        "AllowInsecureHttpForLoopback": true
      }
    },
    "Embeddings": {
      "Provider": "OpenAICompatible",
      "DefaultModel": "local-embedding-model",
      "MockDimensions": 16,
      "MaxInputCharacters": 8000,
      "OpenAiCompatible": {
        "BaseUrl": "http://localhost:1234",
        "EmbeddingsPath": "/v1/embeddings",
        "ApiKey": "local-dev-key",
        "TimeoutSeconds": 30,
        "MaxRetryAttempts": 2,
        "RetryBaseDelayMilliseconds": 200,
        "MaxRetryDelaySeconds": 5,
        "AllowInsecureHttpForLoopback": true
      }
    },
    "DemoAuth": {
      "Enabled": false,
      "AllowInNonDevelopment": false,
      "DefaultUserId": "demo-user",
      "DefaultTenantId": "demo-tenant",
      "DefaultRoles": [ "developer" ],
      "DefaultGroups": [ "demo" ]
    },
    "ApiKeyAuth": {
      "Enabled": false,
      "PermitLimit": 60,
      "WindowSeconds": 60,
      "Credentials": []
    },
    "Postgres": {
      "ConnectionStringName": "IncidentCompass"
    },
    "ConfigSource": {
      "Kind": "File",
      "Path": "../../config/incidentcompass.config.json"
    },
    "IngestionLimits": {
      "MaxPayloadBytes": 65536,
      "MaxAttributesBytes": 16384
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
