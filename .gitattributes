# Normalize line endings: store text as LF in the repository so the same bytes
# are seen on every platform (prevents "passes on Windows, fails in Linux CI").
* text=auto

# Binary assets: never normalize or attempt to diff.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.snk  binary
*.onnx binary
tests/Shared/fixtures/embedding-model/*.model binary

# Sample incident fixtures are byte-pinned by SHA-256 in tests (see
# DemoInjectionScenarioLoader.ExpectedSha256 and TesterInjectionDemoTests). Force LF checkout
# on every platform so the pinned hash matches regardless of core.autocrlf.
samples/**/*.json text eol=lf
