# Local sample configuration for IncidentCompass.
# Copy values into your shell or a local .env file if your tooling loads one.
# The repository ignores .env so machine-specific overrides and real keys stay local.

ASPNETCORE_ENVIRONMENT=Development

# Docker Compose PostgreSQL defaults. These are local-only demo credentials.
# appsettings.json intentionally omits this connection string; supply it through
# a local .env file, shell variables or user secrets.
POSTGRES_DB=incidentcompass
POSTGRES_USER=incidentcompass
POSTGRES_PASSWORD=incidentcompass_dev_password
IC_API_PORT=5198
IC_POSTGRES_PORT=5432

# Shared by API and Worker when running outside Compose.
ConnectionStrings__IncidentCompass=Host=localhost;Port=5432;Database=incidentcompass;Username=incidentcompass;Password=incidentcompass_dev_password
IncidentCompass__Postgres__ConnectionStringName=IncidentCompass

# Product/demo runs use OpenAI-compatible model and embedding providers by default.
# For Docker Compose on Windows/macOS, host.docker.internal points containers at a model server on the host.
INCIDENTCOMPASS_LLM_BASE_URL=http://host.docker.internal:1234
INCIDENTCOMPASS_LLM_CHAT_COMPLETIONS_PATH=/v1/chat/completions
INCIDENTCOMPASS_LLM_MODEL=local-model
INCIDENTCOMPASS_LLM_API_KEY=local-dev-key
INCIDENTCOMPASS_EMBEDDINGS_BASE_URL=http://host.docker.internal:1234
INCIDENTCOMPASS_EMBEDDINGS_PATH=/v1/embeddings
INCIDENTCOMPASS_EMBEDDINGS_MODEL=local-embedding-model
INCIDENTCOMPASS_EMBEDDINGS_API_KEY=local-dev-key

IncidentCompass__ModelGateway__Provider=OpenAiCompatible
IncidentCompass__ModelGateway__OpenAiCompatible__BaseUrl=http://localhost:1234
IncidentCompass__ModelGateway__OpenAiCompatible__ChatCompletionsPath=/v1/chat/completions
IncidentCompass__ModelGateway__OpenAiCompatible__ApiKey=local-dev-key
IncidentCompass__ModelGateway__OpenAiCompatible__AllowInsecureHttpForLoopback=true
IncidentCompass__Embeddings__Provider=OpenAiCompatible
IncidentCompass__Embeddings__OpenAiCompatible__BaseUrl=http://localhost:1234
IncidentCompass__Embeddings__OpenAiCompatible__EmbeddingsPath=/v1/embeddings
IncidentCompass__Embeddings__OpenAiCompatible__ApiKey=local-dev-key
IncidentCompass__Embeddings__OpenAiCompatible__AllowInsecureHttpForLoopback=true

# Per-request OTLP ingestion bounds. MaxSignalsPerExport (1..10000, default 500) caps how many
# records one export may carry, independently of MaxPayloadBytes (default 65536) and
# MaxAttributesBytes (default 16384). An export above the record limit is rejected whole with
# 413 before anything is ingested.
IncidentCompass__IngestionLimits__MaxSignalsPerExport=500

# There is no prompt or provider-body logging switch, because there is no code path
# that writes that material anywhere. Rendered prompts, provider request/response
# bodies, document text, provider credentials and embedding vectors are never
# written to application logs or to the triage ledger, at any log level. See
# docs/observability.md for what the logs and the ledger do carry.

# Demo header auth defaults are for Development quickstart only.
# Non-development opt-in requires an explicit X-Demo-User-Id request header.
IncidentCompass__DemoAuth__Enabled=true
IncidentCompass__DemoAuth__AllowInNonDevelopment=false
