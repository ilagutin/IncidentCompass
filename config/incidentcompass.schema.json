{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://incidentcompass.local/schemas/triage-config-v1.json",
  "title": "IncidentCompass triage configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["Providers", "Routes", "Orchestrator", "Roles", "Tools", "Rules", "Actions", "Ingestion", "FaultGrouping", "Redaction"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "Providers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/provider" }
    },
    "Routes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/route" }
    },
    "Orchestrator": { "$ref": "#/$defs/orchestrator" },
    "Roles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/role" }
    },
    "Tools": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/toolId" },
      "additionalProperties": { "$ref": "#/$defs/tool" }
    },
    "Rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" }
    },
    "Actions": { "$ref": "#/$defs/actions" },
    "Ingestion": { "$ref": "#/$defs/ingestion" },
    "FaultGrouping": { "$ref": "#/$defs/faultGrouping" },
    "Redaction": { "$ref": "#/$defs/redaction" },
    "CurrentReleases": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/nonBlankString" },
      "propertyNames": { "$ref": "#/$defs/nonBlankString" }
    }
  },
  "$defs": {
    "nonBlankString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "toolId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,128}$"
    },
    "referenceString": {
      "type": "string",
      "pattern": "^ref:.+"
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Kind"],
      "properties": {
        "Kind": { "enum": ["Mock", "OpenAICompatible"] },
        "Endpoint": { "type": ["string", "null"] },
        "ApiKeySecretRef": { "type": ["string", "null"] }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Kind", "ProviderId", "Model"],
      "properties": {
        "Kind": { "enum": ["Chat", "Embedding"] },
        "ProviderId": { "$ref": "#/$defs/nonBlankString" },
        "Model": { "$ref": "#/$defs/nonBlankString" },
        "Temperature": { "type": ["number", "null"] },
        "MaxOutputTokens": { "type": ["integer", "null"], "minimum": 1 },
        "ContextWindowTokens": { "type": ["integer", "null"], "minimum": 1 },
        "Reasoning": { "enum": ["off", "low", "medium", "high", null] },
        "FallbackRouteId": { "anyOf": [{ "$ref": "#/$defs/nonBlankString" }, { "type": "null" }] }
      },
      "allOf": [
        {
          "if": {
            "properties": { "Kind": { "const": "Embedding" } },
            "required": ["Kind"]
          },
          "then": {
            "properties": {
              "Reasoning": { "type": "null" },
              "FallbackRouteId": { "type": "null" }
            }
          }
        }
      ]
    },
    "orchestrator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Instructions", "RouteId", "Tools", "Budget"],
      "properties": {
        "Instructions": { "$ref": "#/$defs/referenceString" },
        "RouteId": { "$ref": "#/$defs/nonBlankString" },
        "Tools": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "allOf": [
            { "contains": { "const": "delegate" } },
            { "contains": { "const": "publish_report" } }
          ]
        },
        "Budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["MaxWorkers", "MaxTokens", "MaxWallClockSeconds"],
          "properties": {
            "MaxWorkers": { "type": "integer", "minimum": 1 },
            "MaxTokens": { "type": "integer", "minimum": 1 },
            "MaxWallClockSeconds": { "type": "integer", "minimum": 1 },
            "MaxReprompts": { "type": "integer", "minimum": 0 },
            "MaxTurns": { "type": "integer", "minimum": 1, "maximum": 64 }
          }
        }
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["RouteId", "Instructions", "Tools", "OutputSchema"],
      "properties": {
        "RouteId": { "$ref": "#/$defs/nonBlankString" },
        "Instructions": { "$ref": "#/$defs/referenceString" },
        "Tools": {
          "type": "array",
          "items": { "$ref": "#/$defs/toolId" },
          "uniqueItems": true
        },
        "OutputSchema": { "$ref": "#/$defs/referenceString" }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Kind"],
      "properties": {
        "Kind": { "enum": ["internal", "external_action"] },
        "EmbeddingRouteId": { "type": ["string", "null"] },
        "TopK": { "type": ["integer", "null"], "minimum": 1 },
        "MinScore": { "type": ["number", "null"], "minimum": -1, "maximum": 1 },
        "Category": { "enum": ["notification", "ticket_create", "ticket_update", "code_write", "branch_push", "pr_create", null] },
        "LogicalTargetId": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 },
        "Mode": { "enum": ["live", "dry_run", "disabled", null] }
      },
      "allOf": [
        {
          "if": { "properties": { "Kind": { "const": "external_action" } } },
          "then": { "required": ["Category", "LogicalTargetId"] }
        }
      ]
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Type", "Tool"],
      "properties": {
        "Type": { "enum": ["rate_cap", "precondition", "grounding", "requires_approval"] },
        "Tool": {
          "anyOf": [
            { "const": "*" },
            { "$ref": "#/$defs/toolId" }
          ]
        },
        "Scope": { "enum": ["attempt", "job"] },
        "Max": { "type": ["integer", "null"], "minimum": 1 },
        "RequiresSuccessfulToolResult": {
          "anyOf": [
            { "$ref": "#/$defs/toolId" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "Type": { "const": "rate_cap" } } },
          "then": { "required": ["Max"] }
        },
        {
          "if": { "properties": { "Type": { "const": "precondition" } } },
          "then": { "required": ["RequiresSuccessfulToolResult"] }
        }
      ]
    },
    "actions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["AllowedTools", "DefaultMode", "RequireApprovalForAll", "ApprovalTtlMinutes", "NotificationRoutes"],
      "properties": {
        "AllowedTools": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/toolId" }
        },
        "DefaultMode": { "enum": ["live", "dry_run", "disabled"] },
        "RequireApprovalForAll": { "type": "boolean" },
        "ApprovalTtlMinutes": { "type": "integer", "minimum": 1, "maximum": 10080 },
        "NotificationRoutes": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/notificationRoute" }
        }
      }
    },
    "notificationRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["RouteId", "ToolId", "Severities"],
      "properties": {
        "RouteId": { "$ref": "#/$defs/toolId" },
        "ToolId": { "$ref": "#/$defs/toolId" },
        "ServiceName": { "type": ["string", "null"], "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._:/-]*$" },
        "Environment": { "type": ["string", "null"], "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._:/-]*$" },
        "Severities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "enum": ["error", "critical", "fatal"] }
        }
      }
    },
    "ingestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["DefaultTenant", "AllowedSources"],
      "properties": {
        "DefaultTenant": { "$ref": "#/$defs/nonBlankString" },
        "AllowedSources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["otel", "user", "tester", "manual"] }
        },
        "Otel": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ErrorsOnly", "ServiceAllowList", "SeverityAllowList"],
          "properties": {
            "ErrorsOnly": { "type": "boolean" },
            "ServiceAllowList": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/nonBlankString" }
            },
            "SeverityAllowList": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/nonBlankString" }
            }
          }
        }
      }
    },
    "fingerprintRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Id", "Version", "Inputs"],
      "properties": {
        "Id": { "$ref": "#/$defs/nonBlankString" },
        "Version": { "type": "integer", "minimum": 1 },
        "Inputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["ServiceName", "Environment", "ErrorType", "ErrorMessage", "RouteOrOperation", "OperationName", "HttpRoute", "Severity", "Source"]
          }
        },
        "ServiceName": { "$ref": "#/$defs/nonBlankString" },
        "OperationName": { "$ref": "#/$defs/nonBlankString" },
        "Source": { "enum": ["otel", "user", "tester", "manual"] }
      }
    },
    "recurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["EscalateAfterCount"],
      "properties": {
        "EscalateAfterCount": { "type": "integer", "minimum": 1 }
      }
    },
    "suppressionRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Id", "SilenceWindowMinutes"],
      "properties": {
        "Id": { "$ref": "#/$defs/nonBlankString" },
        "SilenceWindowMinutes": { "type": "integer", "minimum": 1 },
        "ServiceName": { "$ref": "#/$defs/nonBlankString" },
        "Severity": { "$ref": "#/$defs/nonBlankString" }
      }
    },
    "faultGrouping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["LookbackMinutes", "SilenceWindowMinutes", "FingerprintVersion", "MassIssue"],
      "properties": {
        "LookbackMinutes": { "type": "integer", "minimum": 1 },
        "SilenceWindowMinutes": { "type": "integer", "minimum": 1 },
        "FingerprintVersion": { "type": "integer", "minimum": 1 },
        "FingerprintRules": {
          "type": "array",
          "items": { "$ref": "#/$defs/fingerprintRule" }
        },
        "SuppressionRules": {
          "type": "array",
          "items": { "$ref": "#/$defs/suppressionRule" }
        },
        "Recurrence": { "$ref": "#/$defs/recurrence" },
        "MassIssue": {
          "type": "object",
          "additionalProperties": false,
          "required": ["MinNeighborCount", "MinFingerprintStrength"],
          "properties": {
            "MinNeighborCount": { "type": "integer", "minimum": 1 },
            "MinFingerprintStrength": { "enum": ["weak", "strong"] }
          }
        }
      }
    },
    "redactionPattern": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Name", "Pattern"],
      "properties": {
        "Name": { "$ref": "#/$defs/nonBlankString" },
        "Pattern": { "$ref": "#/$defs/nonBlankString" },
        "Replacement": { "$ref": "#/$defs/nonBlankString" },
        "IgnoreCase": { "type": "boolean" }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["AttributeKeys", "Patterns", "UserIdentifierAttributes"],
      "properties": {
        "AttributeKeys": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonBlankString" }
        },
        "Patterns": {
          "type": "array",
          "items": { "$ref": "#/$defs/redactionPattern" }
        },
        "UserIdentifierAttributes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonBlankString" }
        }
      }
    }
  }
}
